{
  "schemaVersion": 1,
  "id": "terrain-diffusion-mc",
  "version": "${version}",
  "name": "Terrain Diffusion Next",
  "description": "Terrain Diffusion Next - AI terrain generation in Minecraft (fork of terrain-diffusion-mc)",
  "authors": ["f1owkang"],
  "contact": {
    "homepage": "https://github.com/f1owkang/Terrain-Diffusion-Next",
    "issues": "https://github.com/f1owkang/Terrain-Diffusion-Next/issues"
  },
  "license": "MIT",
  "icon": "assets/terrain-diffusion-mc/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcDataGenerator"
    ],
    "client": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcClient"
    ],
    "main": [
      "com.github.xandergos.terraindiffusionmc.TerrainDiffusionMc"
    ]
  },
  "mixins": [
    "terrain-diffusion-mc.mixins.json",
    {
      "config": "terrain-diffusion-mc.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}"
  }
}
